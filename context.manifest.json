{
  "name": "origami_creases",
  "version": "1.0.0",
  "description": "Paper folding mathematics, crease patterns, tessellations, and origami-inspired generative art",
  "category": "geometry/folding",
  "tags": ["origami", "crease_pattern", "tessellation", "folding", "paper", "geometry", "rigid_origami", "miura", "sacred_geometry", "deployable"],
  "primary_concepts": [
    "Crease patterns (CP) with mountain/valley assignment",
    "Maekawa and Kawasaki theorems",
    "Rigid origami constraints and mechanisms",
    "Miura-ori tessellation (negative Poisson ratio, single DOF)",
    "Waterbomb tessellation (auxetic, 1-DOF)",
    "Yoshimura diamond-fold cylindrical pattern",
    "Ron Resch triangular tessellation (doubly-curved)",
    "Kresling twist-fold tower (height-rotation coupling)",
    "Curved folding: differential geometry (David Huffman)",
    "Geodesic curvature constraint for curved creases",
    "TreeMaker / circle packing (Robert Lang)",
    "Developable surfaces (K=0 everywhere)",
    "Flat-foldability verification (NP-hard globally)",
    "Modular origami: Sonobe, PHiZZ, kusudama",
    "Thick-panel origami engineering (offset, gap, taper, membrane)",
    "Deployable structures: solar panels, stents, shelters",
    "Gyrification: cortical folding as origami",
    "Islamic geometric patterns as crease systems",
    "Origami architecture: kinetic facades, folded plates",
    "Fold sequences: bases, atomic folds, sequencing complexity"
  ],
  "blend_suggestions": [
    "sacred_geometry",
    "islamic_tiling",
    "crystalline",
    "neural_architecture",
    "bioluminescent_systems",
    "caustic_networks",
    "tesselations"
  ],
  "code_templates": [
    "code/basic_crease.glsl",
    "code/miura_ori.glsl",
    "code/curved_crease.glsl",
    "code/treemaker.glsl",
    "code/emotional_fold.glsl",
