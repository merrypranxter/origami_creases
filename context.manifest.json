  "parameter_space": {
    "foldAngle": {"type": "float", "range": [0.0, 180.0], "default": 90.0},
    "creaseDensity": {"type": "float", "range": [1.0, 100.0], "default": 20.0},
    "mountainRatio": {"type": "float", "range": [0.3, 0.7], "default": 0.5},
    "curvature": {"type": "float", "range": [0.0, 1.0], "default": 0.0},
    "tessellationType": {"type": "enum", "options": ["miura", "resch", "waterbomb", "yoshimura", "custom"], "default": "miura"},
    "foldSequence": {"type": "enum", "options": ["auto", "manual"], "default": "auto"},
    "paperColor": {"type": "enum", "options": ["white", "kraft", "washi", "metallic"], "default": "white"},
    "creaseVisibility": {"type": "float", "range": [0.0, 1.0], "default": 0.8},
    "shadowDepth": {"type": "float", "range": [0.0, 1.0], "default": 0.5},
    "origamiStyle": {"type": "enum", "options": ["geometric", "organic", "modular", "curved"], "default": "geometric"},
    "showMath": {"type": "bool", "default": false}
  },
